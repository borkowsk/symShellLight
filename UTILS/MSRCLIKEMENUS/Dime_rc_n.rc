SSH_AREAMNGR MENU
BEGIN
    POPUP "Models&&Files"
    BEGIN
        MENUITEM "Advanced generic model of negot.(v0.3-2012-3)", RUN_GENMESG
        MENUITEM "Choose definition file for A", CHOOSE_A_DEF_FILE
        MENUITEM "Choose definition file for B", CHOOSE_B_DEF_FILE
        MENUITEM SEPARATOR
        MENUITEM SEPARATOR
        MENUITEM "Visualise data from an exp. file", RUN_FROM_FILE
        MENUITEM "Run dummy model (v0.0-2010)", RUN_DUMMY_MODEL
        MENUITEM "Run messg. model (v0.1-2010)", RUN_MESG1_MODEL
        MENUITEM SEPARATOR
        MENUITEM "Run adv.msg. model (v0.2-2011) on defaults", RUN_ADVMESG_DEF
        MENUITEM "Run issue o. vs. issue o.",   RUN_ADVMESG_I2I
        MENUITEM "Run honor o. vs. honor o.",   RUN_ADVMESG_H2H
        MENUITEM "Run 50/50 issue/honor vs. 50/50", RUN_ADVMESG_5050
        MENUITEM "Run issue/honor 60/40  vs. 40/60 well notion", RUN_ADVMESG_6040_WELL
        MENUITEM "Run issue/honor 60/40  vs. 40/60 wrong notion", RUN_ADVMESG_6040_WRONG
        MENUITEM "Run issue/honor 80/20  vs. 20/80 well notion", RUN_ADVMESG_8020_WELL
        MENUITEM "Run issue/honor 80/20  vs. 20/80 wrong notion", RUN_ADVMESG_8020_WRONG
        MENUITEM "Run honor o. vs. issue o. well notion", RUN_ADVMESG_H2I_WELL
        MENUITEM "Run honor o. vs. issue o. wrong notion", RUN_ADVMESG_H2I_WRONG
        MENUITEM SEPARATOR
        MENUITEM SEPARATOR
        MENUITEM "No detailed loging",          NO_DETAILED_LOG
        MENUITEM "More detailed loging",        MORE_DETAILED_LOG
        MENUITEM "Less detailed loging",        LESS_DETAILED_LOG
        MENUITEM "Log next history to file",    LOG_HISTORY_TO_FILE
        MENUITEM "View final statistics",       CALCULATE_STATISTICS
        MENUITEM SEPARATOR
        MENUITEM "Auto stop negotiations",      RUN_AUTOSTOP
        MENUITEM "Run 10 repetitions",          RUN_10_REPLICATIONS
        MENUITEM "Run 100 repetitions",         RUN_100_REPLICATIONS
        MENUITEM "Run 1000 repetitions",        RUN_1000_REPLICATIONS
        MENUITEM "Dump screen",                 SSH_FILE_DUMPSCREEN
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        SSH_FILE_EXIT
    END
    POPUP "Startup settings"
    BEGIN
        MENUITEM "Will be used from next initialisation!", 0
        MENUITEM SEPARATOR
    END
    MENUITEM "Start/Stop",                  SSH_STARTSTOP
    MENUITEM "One step",                    SSH_ONESTEP
    POPUP "Advise to A"
    BEGIN
        MENUITEM "Action for the side: ",       SSH_ONESTEP, GRAYED
        MENUITEM SEPARATOR
    END
    POPUP "Advise to B"
    BEGIN
        MENUITEM "Action for the side: ",       SSH_ONESTEP, GRAYED
        MENUITEM SEPARATOR
    END
    POPUP "Window"
    BEGIN
        MENUITEM "Simplified layout",           HIDE_SCATTERPLOTS
        MENUITEM "Advanced layout",             UNCOVER_SCATTERPLOTS
        MENUITEM "Time series layout",          ONLY_TIMESERIES
        MENUITEM "Uncover hidden areas",        SSH_WINDOWS_UNCOVERHIDDENAREAS
        MENUITEM "Tile all",                    SSH_WINDOWS_TILE_ALL
        MENUITEM SEPARATOR
        MENUITEM "-right click to mark",        SSH_HELP_SHORTCUTHELP, GRAYED
        MENUITEM "-left click to maximize/restore", SSH_HELP_SHORTCUTHELP, GRAYED
        MENUITEM "Mark all areas",              SSH_WINDOWS_MARKALLAREAS
        MENUITEM "Unmark all areas",            SSH_WINDOWS_UNMARKALLAREAS
        MENUITEM "Tile marked areas",           SSH_WINDOWS_TILEMARKEDAREAS
        MENUITEM "Hide marked areas",           SSH_WINDOWS_HIDEMARKEDAREAS
        MENUITEM "Restore marked to orginal position", SSH_WINDOWS_RESTORETOORGINALPOSITION
        MENUITEM SEPARATOR
        MENUITEM "Subwindows:",                 SSH_HELP_SHORTCUTHELP, GRAYED, MENUBREAK
        MENUITEM SEPARATOR
    END
    POPUP "Help"
    BEGIN
        MENUITEM "Author's WWW page",           SSH_HELP_AUTHORSWWWPAGE
        MENUITEM "Shortcut help",               SSH_HELP_SHORTCUTHELP
    END
END

